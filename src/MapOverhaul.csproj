<Project Sdk="Microsoft.NET.Sdk">

  <!-- Build settings and the common game references live in Directory.Build.props. -->
  <PropertyGroup>
    <AssemblyName>MapOverhaul</AssemblyName>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!-- The icon masks of the cabin and the cave (made by tools/icon_mask.py). -->
  <ItemGroup>
    <EmbeddedResource Include="..\assets\cabin-64.png" LogicalName="MapOverhaul.cabin-64.png" />
    <EmbeddedResource Include="..\assets\cave-64.png" LogicalName="MapOverhaul.cave-64.png" />
  </ItemGroup>

  <!-- The map legend and the icons (uGUI, TextMeshPro, the PNG decode of the icon images). -->
  <ItemGroup>
    <_Ref Include="$(BepInExInterop)\UnityEngine.UI.dll" />
    <_Ref Include="$(BepInExInterop)\UnityEngine.UIModule.dll" />
    <_Ref Include="$(BepInExInterop)\UnityEngine.ImageConversionModule.dll" />
    <_Ref Include="$(BepInExInterop)\Unity.TextMeshPro.dll" />
    <Reference Include="@(_Ref)">
      <HintPath>%(FullPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
